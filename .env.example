# Copy to .env (gitignored) and fill in real values. Never commit secrets.
# Load with: set -a; . ./.env; set +a

# Roblox endpoints: a legacy web-session cookie and/or an Open Cloud key
# ROBLOX_COOKIE=
# ROBLOX_BEARER=

# GitHub endpoints: without it, the anonymous rate limit applies
# GITHUB_TOKEN=
